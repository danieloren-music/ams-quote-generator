# Supabase (Project Settings > API) - רק anon key. אין צורך ב-service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (צד שרת בלבד, לעולם לא עם NEXT_PUBLIC)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend - אופציונלי. בלי זה המערכת מכינה מייל מוכן + קובץ להורדה.
# דורש דומיין מאומת ב-Resend, למשל: AMS RFQ <rfq@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM=
# כתובת שאליה הספקים יענו (אופציונלי)
RESEND_REPLY_TO=
