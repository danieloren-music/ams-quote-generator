# Supabase (Project Settings > API) - רק anon key. אין צורך ב-service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (צד שרת בלבד, לעולם לא עם NEXT_PUBLIC)
GEMINI_API_KEY=
# אופציונלי. אם ריק או שהמודל לא קיים, המערכת בוחרת אוטומטית את מודל ה-Flash העדכני שזמין למפתח
GEMINI_MODEL=

# Resend - אופציונלי. בלי זה המערכת מכינה מייל מוכן + קובץ להורדה.
# דורש דומיין מאומת ב-Resend, למשל: AMS RFQ <rfq@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM=
# כתובת שאליה הספקים יענו (אופציונלי)
RESEND_REPLY_TO=

# ניהול סשן (אופציונלי, אלה ברירות המחדל)
# ניתוק אוטומטי אחרי חוסר פעילות, בדקות
SESSION_IDLE_MINUTES=60
# אורך סשן מקסימלי, בשעות, גם אם פעילים כל הזמן
SESSION_MAX_HOURS=12
